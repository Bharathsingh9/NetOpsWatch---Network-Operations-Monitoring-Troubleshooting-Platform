PROJECT_NAME="NetOpsWatch"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key"
DATABASE_URL="sqlite:///./netopswatch.db"
# To use PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/netopswatch"

DEFAULT_PING_COUNT=4
DEFAULT_PING_TIMEOUT_MS=1000
DEFAULT_MONITORING_INTERVAL_SECONDS=30
LATENCY_WARNING_THRESHOLD_MS=150.0
LATENCY_CRITICAL_THRESHOLD_MS=300.0
PACKET_LOSS_WARNING_THRESHOLD=15.0
PACKET_LOSS_CRITICAL_THRESHOLD=50.0
CONSECUTIVE_FAILURES_BEFORE_DOWN=3
